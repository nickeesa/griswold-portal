# Handoff package: frontend/ (Next.js) + strapi/ (drop-in src+config) + tests/ + docs/.
# Each subproject may also carry its own .gitignore (e.g. frontend/.gitignore);
# this root file is a safety net across all of them.

# OS / Editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Logs
*.log

# Dependencies
node_modules/

# Next.js build output
.next/
out/
build/
dist/

# Environment / secrets — NEVER COMMIT
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx
*.key
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.keystore
credentials.json
service-account*.json

# Strapi / sqlite local runtime (kit overlay / local hop)
.tmp/
.strapi/
.strapi-updater.json
*.db
*.sqlite
*.sqlite3
exports/

# Next.js generated types
next-env.d.ts

# TypeScript incremental
*.tsbuildinfo
