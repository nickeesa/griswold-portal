# Access-control test suite — environment variables.
# Copy to a private location and load before running (see README "How to run").
# DO NOT commit real credentials.

# --- Required ---------------------------------------------------------------
# Base URL of the Strapi instance under test (no trailing slash needed).
STRAPI_URL=https://your-strapi.strapiapp.com

# Two seeded `client` users with DISJOINT property assignments.
# Identifier may be a username OR an email (Strapi accepts both).
USER_A_IDENTIFIER=clienta
USER_A_PASSWORD=change-me

USER_B_IDENTIFIER=clientb
USER_B_PASSWORD=change-me

# A property documentId that User A does NOT own (e.g. one of User B's).
UNOWNED_PROPERTY_ID=abcd1234efgh5678ijkl9012

# Optional: a DRAFT (unpublished) property documentId OWNED by User A (the seed
# prints this as DRAFT_PROPERTY_ID). Enables AC-24's absolute "drafts are never
# served" check. If unset, that one test skips; the relative draft checks still run.
# DRAFT_PROPERTY_ID=mnop3456qrst7890uvwx1234

# --- Optional: AC-4 manual kill-switch test ---------------------------------
# Leave RUN_AC4 unset to skip AC-4. To run it, see the procedure in
# ac-04-blocked-killswitch.test.mjs. Use a DEDICATED throwaway account here,
# NOT USER_A / USER_B.
# RUN_AC4=1
# AC4_USER_IDENTIFIER=blocktest
# AC4_USER_PASSWORD=change-me
# AC4_PAUSE_MS=30000
