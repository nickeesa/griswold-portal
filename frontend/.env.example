# Server-only. NO NEXT_PUBLIC_ prefix — keeps the Strapi origin and JWT out of the client bundle.
STRAPI_URL=https://your-strapi.strapiapp.com

# Cookie name holding the JWT. Must match the login/logout handlers and middleware.
SESSION_COOKIE_NAME=gh_token

# Session cookie lifetime in seconds. MUST be kept in lockstep with the Strapi
# JWT_EXPIRES_IN. Default 7 days (604800). For confidential data, prefer 1 day
# (86400) or less.
# SESSION_MAX_AGE_SECONDS=604800
